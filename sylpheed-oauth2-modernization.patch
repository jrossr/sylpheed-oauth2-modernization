+static gboolean oauth2_error_is_invalid_grant(const gchar *body)
+{
+	const gchar *p;
+
+	if (!body)
+		return FALSE;
+
+	p = strstr(body, "\"error\"");
+	if (!p)
+		return FALSE;
+
+	p += 7;
+	while (g_ascii_isspace(*p))
+		p++;
+
+	if (*p != ':')
+		return FALSE;
+	p++;
+
+	while (g_ascii_isspace(*p))
+		p++;
+
+	if (*p != '\"')
+		return FALSE;
+	p++;
+
+	return !strncmp(p, "invalid_grant\"", 14);
+}
+
+static gchar *oauth2_refresh_access_token(APIInfo *api,
+					       const gchar *refresh_token,
+					       long *r_status)
+{
+	CURL *curl;
+	GString *req_body;
+	gchar *tmp;
+	gchar *header = NULL;
+	gchar *body;
+
+	if (!api || !refresh_token || !*refresh_token)
+		return NULL;
+
+	curl = curl_easy_init();
+	if (!curl)
+		return NULL;
+
+	req_body = g_string_new(NULL);
+
+	tmp = curl_easy_escape(curl, api->client_id, 0);
+	g_string_append_printf(req_body, "client_id=%s", tmp);
+	curl_free(tmp);
+
+	tmp = curl_easy_escape(curl, refresh_token, 0);
+	g_string_append_printf(req_body, "&refresh_token=%s", tmp);
+	curl_free(tmp);
+
+	g_string_append(req_body, "&grant_type=refresh_token");
+
+	if (api->scope && *api->scope) {
+		tmp = curl_easy_escape(curl, api->scope, 0);
+		g_string_append_printf(req_body, "&scope=%s", tmp);
+		curl_free(tmp);
+	}
+
+	if (api->client_secret && *api->client_secret) {
+		tmp = curl_easy_escape(curl, api->client_secret, 0);
+		g_string_append_printf(req_body, "&client_secret=%s", tmp);
+		curl_free(tmp);
+	}
+
+	body = http_post(api->token_uri, req_body->str, &header, r_status);
+
+	if (header) {
+		debug_print("refresh response header:\n%s\n", header);
+		g_free(header);
+	}
+
+	g_string_free(req_body, TRUE);
+	curl_easy_cleanup(curl);
+
+	return body;
+}
