+static gchar *get_token_cache_path(const gchar *user)
+{
+	gchar *safe_user;
+	gchar *filename;
+	gchar *path;
+
+	if (!user || !*user)
+		return NULL;
+
+	safe_user = g_strdup(user);
+	subst_for_filename(safe_user);
+
+	filename = g_strdup_printf("oauth2-token-%s", safe_user);
+	path = g_strconcat(get_rc_dir(), G_DIR_SEPARATOR_S, filename, NULL);
+
+	g_free(filename);
+	g_free(safe_user);
+
+	return path;
+}
+
+static gchar *load_refresh_token(const gchar *user)
+{
+	gchar *path;
+	gchar *token = NULL;
+	GError *error = NULL;
+
+	path = get_token_cache_path(user);
+	if (!path)
+		return NULL;
+
+	if (!g_file_get_contents(path, &token, NULL, &error)) {
+		if (!g_error_matches(error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+			g_warning("could not read OAuth2 token cache: %s",
+				  error->message);
+		g_error_free(error);
+		g_free(path);
+		return NULL;
+	}
+
+	g_free(path);
+	g_strstrip(token);
+
+	if (!*token) {
+		g_free(token);
+		return NULL;
+	}
+
+	return token;
+}
+
+static void remove_refresh_token(const gchar *user)
+{
+	gchar *path;
+
+	path = get_token_cache_path(user);
+	if (!path)
+		return;
+
+	if (g_unlink(path) < 0 && errno != ENOENT)
+		FILE_OP_ERROR(path, "unlink");
+
+	g_free(path);
+}
+
+static gint save_refresh_token(const gchar *user, const gchar *token)
+{
+	gchar *path;
+	gchar *tmppath;
+	FILE *fp;
+	gint ret = -1;
+
+	if (!token || !*token)
+		return -1;
+
+	path = get_token_cache_path(user);
+	if (!path)
+		return -1;
+
+	tmppath = g_strconcat(path, ".tmp", NULL);
+
+	fp = g_fopen(tmppath, "wb");
+	if (!fp) {
+		FILE_OP_ERROR(tmppath, "fopen");
+		goto out;
+	}
+
+	if (change_file_mode_rw(fp, tmppath) < 0) {
+		FILE_OP_ERROR(tmppath, "chmod");
+		fclose(fp);
+		g_unlink(tmppath);
+		goto out;
+	}
+
+	if (fputs(token, fp) == EOF || fputc('\n', fp) == EOF) {
+		g_warning("writing OAuth2 token cache failed");
+		fclose(fp);
+		g_unlink(tmppath);
+		goto out;
+	}
+
+	if (fclose(fp) == EOF) {
+		g_warning("closing OAuth2 token cache failed");
+		g_unlink(tmppath);
+		goto out;
+	}
+
+	if (rename_force(tmppath, path) < 0) {
+		FILE_OP_ERROR(path, "rename");
+		g_unlink(tmppath);
+		goto out;
+	}
+
+	ret = 0;
+
+out:
+	g_free(tmppath);
+	g_free(path);
+
+	return ret;
+}
