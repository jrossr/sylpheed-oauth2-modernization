+static void base64_to_base64url(gchar *str)
+{
+	gint i;
+
+	for (i = 0; str[i] != '\0'; i++) {
+		if (str[i] == '+')
+			str[i] = '-';
+		else if (str[i] == '/')
+			str[i] = '_';
+		else if (str[i] == '=') {
+			str[i] = '\0';
+			break;
+		}
+	}
+}
+
+static gboolean secure_random_fill(guchar *data, gsize len)
+{
+	gsize offset = 0;
+
+	while (offset < len) {
+		ssize_t n;
+
+		n = getrandom(data + offset, len - offset, 0);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return FALSE;
+		}
+
+		if (n == 0)
+			return FALSE;
+
+		offset += n;
+	}
+
+	return TRUE;
+}
+
+static gchar *generate_code_verifier(void)
+{
+	guchar data[32];
+	gchar *str;
+
+	if (!secure_random_fill(data, sizeof(data)))
+		return NULL;
+
+	str = g_malloc(64);
+	base64_encode(str, data, sizeof(data));
+	base64_to_base64url(str);
+
+	return str;
+}
+
+static gchar *generate_code_challenge(const gchar *verifier)
+{
+	GChecksum *checksum;
+	guchar digest[32];
+	gsize digest_len = sizeof(digest);
+	gchar *str;
+
+	checksum = g_checksum_new(G_CHECKSUM_SHA256);
+	if (!checksum)
+		return NULL;
+
+	g_checksum_update(checksum, (const guchar *)verifier, strlen(verifier));
+	g_checksum_get_digest(checksum, digest, &digest_len);
+	g_checksum_free(checksum);
+
+	str = g_malloc(64);
+	base64_encode(str, digest, digest_len);
+	base64_to_base64url(str);
+
+	return str;
+}
 
